<Project>

    <!--
        Imported automatically when a project references FadeBasic.Testing.
        Owns testing-related MSBuild targets:
          - FADE0001: warn if the deprecated FadeGenerateNUnitFixture flag is set.
          - FADE0003: warn if global.json doesn't opt into Microsoft.Testing.Platform.
          - EnsureFadeTestingGlobalJson: auto-write a minimal global.json on
            first build so `dotnet test` opts into MTP without the user having
            to author the file by hand.
        FADE0002 (must reference FadeBasic.Testing when FadeEnableTesting is
        on) lives in FadeBasic.Build.targets — by definition it has to fire
        from the Build package, since these targets won't load if the
        Testing package isn't referenced.
    -->

    <!-- Migration warning for the deprecated NUnit-fixture flag. Surface it
         at the start of the build so users see it before any other Fade
         work runs. -->
    <Target Name="WarnDeprecatedFadeFlags" BeforeTargets="GenerateFadeBasic"
            Condition="'$(_FadeNUnitFlagDeprecated)'=='true'">
        <Warning Code="FADE0001"
                 Text="FadeGenerateNUnitFixture is no longer supported. Replace with &lt;FadeEnableTesting&gt;true&lt;/FadeEnableTesting&gt; — Fade tests now run via Microsoft.Testing.Platform via the FadeBasic.Testing adapter; no NUnit dependency is required." />
    </Target>

    <!-- Upgrade-path warning. Earlier FadeBasic.Testing versions (Stage 11A-G)
         defaulted to MTP and auto-wrote a global.json declaring the MTP
         runner. The current default is VSTest (FadeUseMtpRunner=false),
         because Rider's MTP support is still incomplete. If a stale
         MTP-flavored global.json is left over, `dotnet test` will silently
         try to route through MTP and fail with confusing Newtonsoft.Json /
         "no test runner" errors. Detect and warn. -->
    <Target Name="WarnStaleMtpGlobalJson" BeforeTargets="GenerateFadeBasic"
            Condition="'$(FadeEnableTesting)'=='True' and '$(FadeUseMtpRunner)'!='True' and Exists('$(MSBuildProjectDirectory)/global.json')">
        <PropertyGroup>
            <_FadeStaleMtpJsonPath>$(MSBuildProjectDirectory)/global.json</_FadeStaleMtpJsonPath>
        </PropertyGroup>
        <Warning Code="FADE0004"
                 Condition="$([System.IO.File]::ReadAllText($(_FadeStaleMtpJsonPath)).Contains('Microsoft.Testing.Platform'))"
                 Text="$(_FadeStaleMtpJsonPath) opts `dotnet test` into Microsoft.Testing.Platform, but FadeUseMtpRunner is not set. Earlier FadeBasic.Testing versions auto-wrote this file; the current default is classic VSTest (which works in Rider, VS Code, and `dotnet test`). Either delete the &quot;test&quot;: { &quot;runner&quot; } stanza from global.json, or set &lt;FadeUseMtpRunner&gt;true&lt;/FadeUseMtpRunner&gt; to keep MTP for `dotnet test` (note: Rider does not yet support MTP discovery)." />
    </Target>

    <!-- `dotnet test` in .NET 10 still defaults to VSTest. To use the MTP
         runner, the SDK requires a global.json in the project directory tree
         containing { "test": { "runner": "Microsoft.Testing.Platform" } }.
         There is no csproj-level equivalent — the runner is decided at CLI
         parse time, before any project file is loaded. (Verified against
         dotnet sdk 10.0.103 by IL-decompiling
         Microsoft.DotNet.Cli.Commands.Test.TestCommandParser.GetTestRunnerName,
         which reads global.json and nothing else.)

         To preserve the "single PackageReference is the opt-in" UX, we
         auto-write a minimal global.json next to the project on first build
         when none exists. If the user has their own global.json (e.g., for
         SDK pinning), we don't touch it — instead FADE0003 warns and tells
         them what stanza to add. -->
    <Target Name="EnsureFadeTestingGlobalJson" BeforeTargets="GenerateFadeBasic"
            Condition="'$(FadeEnableTesting)'=='True' and '$(FadeUseMtpRunner)'=='True'">
        <PropertyGroup>
            <_FadeGlobalJsonPath>$(MSBuildProjectDirectory)/global.json</_FadeGlobalJsonPath>
            <_FadeGlobalJsonContent>{
  "_comment": "Generated by FadeBasic.Testing because the package is referenced. Required so `dotnet test` opts into Microsoft.Testing.Platform. Safe to edit; the build only writes this file when no global.json exists.",
  "test": {
    "runner": "Microsoft.Testing.Platform"
  }
}</_FadeGlobalJsonContent>
        </PropertyGroup>

        <WriteLinesToFile Condition="!Exists($(_FadeGlobalJsonPath))"
                          File="$(_FadeGlobalJsonPath)"
                          Lines="$(_FadeGlobalJsonContent)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <Message Condition="!Exists($(_FadeGlobalJsonPath))"
                 Importance="High"
                 Text="[FADE] Wrote $(_FadeGlobalJsonPath) so `dotnet test` opts into Microsoft.Testing.Platform. Commit it alongside the csproj." />

        <!-- If the user already has a global.json, we don't risk merging into
             it from MSBuild (parsing JSON in MSBuild is unsafe) — emit a
             clear warning telling them what to add. -->
        <Warning Code="FADE0003"
                 Condition="Exists($(_FadeGlobalJsonPath)) AND !$([System.IO.File]::ReadAllText($(_FadeGlobalJsonPath)).Contains('Microsoft.Testing.Platform'))"
                 Text="FadeEnableTesting is on but $(_FadeGlobalJsonPath) does not opt into Microsoft.Testing.Platform. `dotnet test` will route through VSTest and fail with a Newtonsoft.Json error. Add this stanza to global.json (it can sit alongside &quot;sdk&quot;):%0A  &quot;test&quot;: { &quot;runner&quot;: &quot;Microsoft.Testing.Platform&quot; }" />
    </Target>

</Project>
