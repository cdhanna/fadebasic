_setupAnimatics:

  ` setup the main backdrop
  animBackdropSprite = reserve sprite id(animBackdropSprite)
  sprite animBackdropSprite, 0, 0, 0
  color Sprite animBackdropSprite, backgroundColor
  size sprite animBackdropSprite, render width(), render height()
  set sprite offset animBackdropSprite, 0, 0
  order sprite animBackdropSprite, ORDER_ANIM
  set sprite alpha animBackDropSprite, 0

  animBackdropTween = reserve tween id(animBackdropTween)

  ` skip text
  animSkipText = reserve text id(animSkipText)
  text animSkipText, render width()/2, render height() - 60, 1, "hold left shift to skip"
  size text y animSkiptext, 20
  enable text drop shadow animSkipText, 4, -4, rgb(0,0,0)
  order text animSkipText, ORDER_ANIM + 100
  set text alpha animSkipText, 180

  animSkipSprite = reserve sprite id(animSkipSprite)
  skipWidth = 220
  sprite animSkipSprite, (render width()/2)-skipWidth, render height() - 40, 0
  size sprite animSkipSprite, 0, 4
  set sprite offset animSkipSprite, 0, .5
  order sprite animSkipSprite, ORDER_ANIM + 100
  set sprite alpha animSkipSprite, 100


  ignoreAnimaticStartFade = 0
  ignoreAnimaticEndFade = 0
  effect 1, "mask"

  remstart
    An animatic is made up of several little animations. 
    To control this, we'll have a big array of anim objects
    and they get setup programmatically.

    Then we run through the anim array until all of them are complete. 
    At that point, the animatic is complete. 


  remend

  global MAX_ANIM_COUNT = 200
  DIM anims(MAX_ANIM_COUNT) as anim
  anim as anim
  animCount = 0


  dim animSpriteIds(MAX_ANIM_COUNT)
  for n = 0 to MAX_ANIM_COUNT - 1
    reserve sprite id(animSpriteIds(n))
  next

  dim animSfxIds(MAX_ANIM_COUNT)
  for n = 0 to MAX_ANIM_COUNT - 1
    reserve sfx id(animSfxIds(n))
  next

  ` reserve some panel textures
  ` global MAX_PANEL_COUNT = 10
  ` DIM panels(MAX_PANEL_COUNT)
  ` panelCount = 0
  ` for n = 0 to len(panels) - 1
  `   panels(n) = reserve render target id(panels(n))
  ` next

  forceTimeStart = 0*1000 ` reset to zero after adding new anims

RETURN

_playAnimatic:

  ` bring in the backdrop
  ` show sprite animbackdropsprite
  startSkip = 0
  size sprite animskipsprite, 0*skipWidth*2, 4
  skipRatio# = 0
  if ignoreAnimaticStartFade = 0
    create basic tween animBackdropTween, 0, 1, 500, 0
    while is tween done(animbackdroptween) = 0
      set sprite alpha animbackdropsprite, tweenVal(animBackdropTween) * 255
      set sprite alpha animskipsprite, tweenVal(animBackdropTween) * 100
      set text alpha animskiptext, tweenVal(animBackdropTween) * 180
      sync
    endwhile
  endif

  highestEndMs = 0

  ` setup all the sprites
  for n = 0 to animCount - 1
    anim = anims(n)

    anim.pos = anim.startPos
    anim.size = anim.startSize

    anim.volume = anim.startVolume
    anim.pitch = anim.startPitch
    anim.pan = anim.startPan

    if anim.sfxClipId
      sfx animSfxIds(n), anim.sfxClipId
    endif

    sprite animSpriteIds(n), anim.pos.x, anim.pos.y, anim.textureId
    set sprite offset animSpriteIds(n), 0, 0
    size sprite animSpriteIds(n), anim.size.x, anim.size.y
    color sprite animSpriteIds(n), rgb(255, 255, 255)
  
    order sprite animSpriteIds(n), ORDER_ANIM + 200+ anim.order
    set sprite alpha animSpriteIds(n), 255
    if anim.endTimeMs > highestEndMs
      highestEndMs = anim.endTimeMs
    endif

    if anim.animMaskIndex
      set sprite effect animSpriteIds(n), 1
    else 
      set sprite effect animSpriteIds(n), 0
    endif
    set sprite flip animSpriteIds(n), anim.xFlip, 0

    if anim.color <> 0 then color sprite animSpriteIds(n), anim.color

    anims(n) = anim
    ` set sprite gizmo thickness animSpriteIds(n), anim.borderWidth 
  next

  ` correct any animations
  for n = 0 to animCount - 1
    anim = anims(n)
    if anim.endTimeMs <= 0
      anim.endTimeMs = highestEndMs
    endif
    if anim.locktime <= 0
      anim.lockTime = anim.endTImeMs
    endif
    if anim.fadeOutTimems <= 0
      anim.fadeOutTimeMs = 0
    endif
    if anim.fadeInTimeMs <= 0
      anim.fadeInTimeMs = 100
    endif

    if anim.startVolume =0
      anim.startVolume = 1
    endif
    if anim.endVolume=0
      anim.endVolume = anim.startVolume

    endif

     if anim.startPitch =0
      anim.startPitch = 1
    endif
    if anim.endPitch =0
      anim.endPitch = anim.startPitch
    endif

     if anim.startPan=0
      anim.startPan = 1
    endif
    if anim.endPan=0
      anim.endPan = anim.startPan
    endif
    anims(n) = anim
  next


  animStartMs = timer()

  skipDuration as float = 600
  startSkip = 0
  do
  
    time = (timer() - animStartMs) + forceTimeStart
    ` time = forceTimeStart

    if (left shiftKey())
      if startSkip = 0
        startSkip = time
      endif

      skipRatio# = min(1, 1 - (((startSkip + skipDuration) - time) / skipDuration))
      size sprite animskipsprite, skipRatio# * skipWidth*2, 4
      else
      startSkip = 0
      size sprite animskipsprite, 0*skipWidth*2, 4
      skipRatio# = 0
    endif
    if skipRatio# >= 1
      time = highestEndMs + 1
    endif

    anyLeft = 0

    for n = 0 to animCount - 1
      anim = anims(n)

      ` how many ms away from the start are we? 
      `  negative numbers are leading up to the start time, 
      `  positive numbers are into the animation. 
      animTime = time - anim.startTimeMs

      fadeInTime = -anim.fadeInTimeMs
      fadeInRatio# = 1 - max(0, min(1, (fadeInTime - animTime) / (anim.fadeInTimeMs+1) ))`(-500 - -300)/-500 = -200 /-500 = -.2

      ` fadeInRatio# = fadeInRatio#*fadeInRatio#*fadeInRatio#

      fadeOutTime = (anim.endTimeMs-anim.startTimeMs) - anim.fadeOutTimeMs
      fadeOutRatio# = max(0, min(1, (fadeOutTime - animTime) / (anim.fadeOutTimeMs + 1)))
      lockTime = (anim.lockTime-anim.startTimeMs)

      if animTime < 0
        set sprite alpha animSpriteIds(n), fadeInRatio# * 255
      else
        set sprite alpha animSpriteIds(n), fadeOutRatio# * 255
      endif

      if animTime > anim.sfxDelayMs and anim.sfxClipId and skipRatio# < 1
        print "I WAN TTO PLAY", animSfxIds(n), anim.sfxClipId, anim.startVolume, anim.endVolume
        play sfx animSfxIds(n)
        anim.sfxCliPId = 0

      endif

      animRatio# = max(0, min(1, 1 - ((lockTime - animTime + 0.0) / (lockTime - fadeInTime)))) 
      ` print "anim ratio", animRatio#

      set sfx volume animSfxIds(n), anim.startVolume + animRatio# * (anim.endVolume - anim.startVolume)
      ` set sfx pitch animSfxIds(n), anim.startPitch + animRatio# * (anim.endPitch - anim.startPitch)
      ` set sfx pan animSfxIds(n), anim.startPan + animRatio# * (anim.endPan - anim.startPan)

      if anim.endPos.x <> 0 
        anim.pos.x = anim.startPos.x + animRatio# * (anim.endPos.x - anim.startPos.x)
        anim.pos.y = anim.startPos.y + animRatio# * (anim.endPos.y - anim.startPos.y)
        position sprite animSpriteIds(n), anim.pos.x, anim.pos.y
      endif
      if anim.endSize.x <> 0
        anim.size.x = anim.startSize.x + animRatio# * (anim.endSize.x - anim.startSize.x)
        anim.size.y = anim.startSize.y + animRatio# * (anim.endSize.y - anim.startSize.y)
        size sprite animSpriteIds(n), anim.size.x, anim.size.y
      endif

      anims(n) = anim


      if (anim.animMaskIndex)
        ` set sprite 
        ` maskSpriteId = animSpriteIds(anim(maskSpriteId-1))
        panel as anim = anims(anim.animMaskIndex - 1)

        sw# = anim.size.x
        sh# = anim.size.y
        sx# = anim.pos.x
        sy# = anim.pos.y
        px# = panel.pos.x
        py# = panel.pos.y
        pw# = panel.size.x
        ph# = panel.size.y
        
        uvX1# = (px# - sx#) / sw#
        uvX2# = ((px# + pw#) - sx#) / sw#
        uvY1# = (py# - sy#) / sh#
        uvY2# = ((py# + ph#) - sy#) / sh#

        if (anim.xFlip)
          uvX1# = 1 - uvX1#
          uvX2# = 1 - uvX2#

          temp# = uvX1#
          uvX1# = uvX2#
          uvX2# = temp#
          ` enable sprite gizmo animSpriteIds(n)
        endif

        set sprite all texcoord1 animSpriteIds(n), uvX1#, uvY1#, uvX2#, uvY2#
      endif


      if time < anim.endTimeMs
        anyLeft = 1
      endif


    next

    if not anyLeft
      exit
    endif
    sync
  loop


  if ignoreAnimaticEndFade = 0
    create basic tween animBackdropTween, 1, 0, 500, 0

    while is tween done(animbackdroptween) = 0
      ` set sprite alpha animbackdropsprite, tweenVal(animBackdropTween) * 255
      set sprite alpha animskipsprite, tweenVal(animBackdropTween) * 100
      set text alpha animskiptext, tweenVal(animBackdropTween) * 180
      sync
    endwhile
  endif

RETURN

type anim

  `[REQUIRED] the sprite's texture
  textureId

  `[REQUIRED] at what point does this animation enter
  startTimeMs as float

  `[REQUIRED] at what point does this animation exit
  endTimeMs as float

  startPos as iVec
  startSize as iVec
  pos as iVec
  size as iVec

  sfxClipId
  sfxDelayMs
  volume as float
  startVolume as float
  endVolume as float
  pan as float
  startPan as float
  endPan as float
  pitch as float
  startPitch as float
  endPitch as float


  `[OPTIONAL] 
  fadeInTimeMs as float

  `[OPTIONAL] 
  fadeOutTimeMs as float

  lockTime 
  endPos as iVec
  endSize as iVec

  xFlip
  color
  animMaskIndex
  borderWidth
  order
endtype


_resetAnim:
  for n = 0 to MAX_ANIM_COUNT - 1
    anim = anims(n)
    ` anim.color = rgb(255, 255, 255)
    
    anims(n) = anim
  next
RETURN

function addAnim(textureId, duration, pos as iVec, size as iVec)

endfunction

