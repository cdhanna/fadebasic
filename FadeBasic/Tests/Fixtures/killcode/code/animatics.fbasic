  anims(0) = {
    textureId = 0,
    startTimeMs = 200
    lockTime = 1000
    startPos = {
      x = 100,
      y = 100
    },
    endPos = {
      x = 200,
      y = 0
    }
    startSize = {
      x = 300
      y = 300
    }
    borderWidth = 12
    color = rgb(255, 146, 146)
  }

  anims(1) = {
    textureId = happyDanceTextures(2),
    startTimeMs = 400
    endTimeMs = 4000
    ` lockTime = 1000
    startPos = {
      x = 150,
      y = 100
    },
    startSize = {
      x = 400
      y = 400
    },
    endSize = {
      x = 300, y = 300
    }

    ` animMaskIndex = 1 ` use the index+1
  }

  animCount = 2

RETURN


_fullAnimIntro:

  ` reserve sfx id(introSFX)
  ` sfx introSFX
  ignoreAnimaticEndFade = 1
  ignoreAnimaticStartFade = 0

  GOSUB _animintro
  GOSUB _playanimatic
  ignoreAnimaticStartFade = 1

  GOSUB _intro3
  GOSUB _playanimatic

  GOSUB _intro4
  GOSUB _playanimatic


  GOSUB _intro5
  GOSUB _playanimatic

  GOSUB _intro6
  GOSUB _playanimatic

  ignoreAnimaticEndFade = 0

  GOSUB _intro7
  GOSUB _playanimatic

  ignoreAnimaticStartFade = 0


RETURN

