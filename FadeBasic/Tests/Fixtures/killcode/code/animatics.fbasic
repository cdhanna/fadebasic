` setup a test animation
_animIntro:
  GOSUB _resetAnim

  clipLength = 7
  clipLength2 = 9
  clipLength3 = 6

  clip2EndTime = clipLength + clipLength2
  clip3EndTime = clip2EndTime + clipLength3

  w# = 486
  h# = 343

  a# = w# / h#
  y# = (render width()-200) / a#
  x# = (render height()-200) * a#


  `first panel
  anims(0) = {
    textureId = 0,
    startTimeMs = 200
    endTimeMs = 10 * 1000
    startPos = {
      x = 100,
      y = 100
    }
    startSize = {
      x = x#
      y = render height() - 200
    }
    color = rgb(0, 0, 0)
  }

  ` city backdrop, panel 1 486x343
  anims(1) = {
    textureId = TEX_NIGHTSCAPE,
    startTimeMs = 200
    lockTime = clipLength * 1000
    endTimeMs = clipLength * 1000

    startPos = {
      x = 100,
      y = 100
    }
    endPos = {
      x = 50,
      y = 100
    }
    startSize = {
      x = x# * 1.2
      y = (render height()-200) * 1.2
    }
    color = rgb(205, 205, 205)
    animMaskIndex = 1 ` use the index+1
  }

  ` hooded man
  anims(2) = {
    textureId = TEX_HOODED_MAN,
    startTimeMs = 200
    lockTime = clipLength * 1000
    endTimeMs = clipLength * 1000
    order = 10
    ` endTimeMs = 10 * 1000
    startPos = {
      x = 630,
      y = render height() - (200 +128)
    }
    endPos = {
      x = 630 - 30,
      y = render height() - (200 +128)
    }
    startSize = {
      x = 128
      y = 256
    }
    endSize = {
      x = 128*1.3
      y = 256*1.3
    }
    color = rgb(119, 119, 119)
    animMaskIndex = 1 ` use the index+1
  }

  redTint = rgb(255, 194, 194)
  anims(3) = {
    textureId = TEX_NIGHTSCAPE,
    startTimeMs = clipLength * 1000
