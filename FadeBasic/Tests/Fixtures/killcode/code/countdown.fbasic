_setupCountdown:

  countdownSprite = reserve sprite id(countdownSprite)
  countdownText = reserve text id(countdownText)
  countdownTween = reserve tween id(countdownTween)
  countdownTween2 = reserve tween id(countdownTween2)
  text countdowntext, render width()/2, render height()/2, 1, "3"
  enable text drop shadow countdowntext, -40, -40, rgb(0,0,0)
  ` size text x countdownText, render width()*.25

  set text alpha countdownText, 0

  dim countdownWords$(3)
  countdownWords$(0) = "GO!"
  countdownWords$(1) = "DANCE!"
  countdownWords$(2) = "HACK!"

RETURN

_doCountdown:

  countdown = startCountdown

  for n = startCountdown to 0 step -1
    set text alpha countdownText, 1

    select n
      case 0
        set text countdownText, countdownWords$(rnd(len(countdownWords$) - 1))
      endcase
      case default
        set text countdowntext, str$(n)
      endcase
    endselect
    size text x countdownText, render width()*(.2)

    create basic tween countdowntween, 0, 1, 300, 600
    create basic tween countdowntween2, 0, 1, 700, 300
    set tween easing countdowntween2, 2

    repeat 

      if new key down(27)
        set text alpha countDownText, 0
        GOTO _mainmenu
      endif

      r# = tweenVal(countdownTween)
      r2# = tweenVal(countdownTween2)
      set text alpha countdownText, (1-r#) * 255
      size text x countdownText, render width()*(.2 + r2#*.1)
      sync
    until is tween done(countdowntween)
  next


RETURN