<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>FadeBasic.LSP.Core</AssemblyName>
        <RootNamespace>FadeBasic.LSP.Core</RootNamespace>
        <!-- netstandard2.1 so this works in both net8 (native OmniSharp LSP)
             and net10 WASM (WebRuntime / FadeBridge). Matches FadeBasic.Lang.Core. -->
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FadeBasic\FadeBasic.csproj" />
    </ItemGroup>

</Project>
