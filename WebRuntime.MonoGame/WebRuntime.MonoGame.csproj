<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WebRuntime.MonoGame</RootNamespace>
    <AssemblyName>WebRuntime.MonoGame</AssemblyName>
    <!-- KNI requires this define for its WebGL platform code paths. -->
    <DefineConstants>$(DefineConstants);BLAZORGL</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trimming off for first boot. Revisit as an optimization later — we don't
         have XnaFiddle's "Roslyn needs full metadata" problem, so trimming should
         eventually be safe for us. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Single source of truth for KNI version. XnaFiddle pins to 4.2.9001.2 for
       the Blazor.GL platform; we match. Bump as a single edit when KNI updates. -->
  <PropertyGroup>
    <KniPlatformBlazorGLVersion>4.2.9001.2</KniPlatformBlazorGLVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.17" PrivateAssets="all" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="$(KniPlatformBlazorGLVersion)" />
  </ItemGroup>

  <!--
    Cross-repo ProjectReference into Fade.MonoGame. Multi-targeted there;
    SetTargetFramework forces the net8.0 (browser) flavor regardless of how
    the default resolution would pick. Lib transitively brings in Game and
    Contracts (also multi-targeted), so we don't need to list them here.

    If this path stops resolving (someone clones dby/ without the sibling
    Fade.MonoGame repo), the build will fail at restore with a clear "project
    not found" error.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Fade.MonoGame\Fade.MonoGame\Fade.MonoGame.Lib\Fade.MonoGame.Lib.csproj">
      <SetTargetFramework>TargetFramework=net8.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

</Project>
