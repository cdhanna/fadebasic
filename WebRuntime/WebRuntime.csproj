<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FadeBasic\FadeBasic\FadeBasic.csproj" />
    <ProjectReference Include="..\FadeBasic\FadeBasic.Lib.Standard\FadeBasic.Lib.Standard.csproj" />
    <ProjectReference Include="..\FadeBasic\LSP.Core\FadeBasic.LSP.Core.csproj" />
    <!-- ApplicationSupport gives us ProjectDocs + MarkdownDocParser so we
         can reuse the same XML-doc → markdown pipeline the native LSP uses
         (instead of re-implementing it here). Microsoft.Build refs inside
         it use ExcludeAssets="runtime", so they don't ship to WASM. -->
    <ProjectReference Include="..\FadeBasic\ApplicationSupport\ApplicationSupport.csproj" />
    <ProjectReference Include="..\FadeBasic\CommandSourceGenerator\CommandSourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
