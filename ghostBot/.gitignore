# ── Frontend (Vite) ──────────────────────────────────────────────
node_modules/
dist/
*.local

# ── Rust / Tauri (src-tauri) ─────────────────────────────────────
src-tauri/target/
# Generated by `tauri build`/`tauri dev` from tauri.conf.json + capabilities
# + permissions — deterministic, regenerated every build, so not committed.
src-tauri/gen/schemas/

# ── Secrets / local env ──────────────────────────────────────────
# (the Claude API key lives in the OS app-data dir, not here — but keep
#  stray .env files out of the repo regardless.)
.env
.env.*

# ── OS / editor ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
