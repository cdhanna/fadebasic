{
  "name": "fade-home-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:help": "node ../../Fade.Playground/packages/md-to-svelte/src/generate.mjs ../FadeBasic/book/FadeBook/Language.md --out src/generated/help-content.js --title \"Fade Language\"",
    "gen:tutorial": "node ../../Fade.Playground/packages/md-to-svelte/src/generate.mjs ../FadeBasic/book/FadeBook/Game.md --out src/generated/game-content.js --title \"Game Tutorial\"",
    "gen:commands": "node scripts/gen-commands.mjs",
    "stage:fade": "node scripts/stage-fade.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "stage:assets": "node scripts/stage-assets.mjs",
    "prep": "npm run gen:help && npm run gen:tutorial && npm run gen:commands && npm run stage:fade && npm run stage:assets",
    "predev": "npm run prep",
    "prebuild": "npm run prep",
    "dev": "vite --config vite.dev.config",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.19.6",
    "vite": "^6.1.0"
  }
}
