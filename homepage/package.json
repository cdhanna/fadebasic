{
  "name": "fade-home-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:help": "node ../../Fade.Playground/packages/md-to-svelte/src/generate.mjs ../FadeBasic/book/FadeBook/Language.md --out src/generated/help-content.js --title \"Fade Language\"",
    "stage:fade": "node scripts/stage-fade.mjs",
